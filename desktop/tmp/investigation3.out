    Move macOS back to IOKit HID injection because CG is shite

diff --git a/src/input/inject_macos.rs b/src/input/inject_macos.rs
index 5080eae..ab68d49 100644
--- a/src/input/inject_macos.rs
+++ b/src/input/inject_macos.rs
@@ -7,7 +7,7 @@ use std::time::{Duration, Instant};
 
